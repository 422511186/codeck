# 个人访问 token：调用本项目后端时使用这个值。
# 配置后优先使用这个值；不配置时后端启动会自动生成一个随机长 token 并打印到控制台。
# CODEX_WEB_ACCESS_TOKEN=sk-替换成你的登录token

# 允许后端操作的工作区根目录。多个目录可用分号分隔。
CODEX_WEB_WORKSPACE_ROOTS=/path/to/your/workspace

# 图片上传暂存目录。发送图片时后端会保存到这里，再用 localImage 传给 Codex app-server。
CODEX_WEB_UPLOAD_DIR=/path/to/your/workspace/codex-web/uploads

# Web 服务监听地址。需要局域网访问时通常配置 0.0.0.0。
CODEX_WEB_BIND_HOST=0.0.0.0
CODEX_WEB_BIND_PORT=3000
# 允许通过域名访问 Next dev/HMR。多个域名用英文分号分隔，不要带 http/https。
# CODEX_WEB_ALLOWED_DEV_ORIGINS=codex.example.com

# Codex app-server 接入模式：
# spawn：默认，当前 Web 后端按需启动并拥有一个本机 codex app-server；不承诺跨 Web 后端复用。
# external：连接你自己启动的 app-server，需要同时配置 CODEX_WEB_APP_SERVER_URL；推荐生产和多个 Web 后端复用。
# spawn-or-connect：固定 host/port 时先连接已有 app-server，连接失败后加锁启动，适合本机开发自动复用。
# mock：返回稳定模拟数据，供后端联调和单元测试。
# off：关闭 app-server 接入。
CODEX_WEB_APP_SERVER_MODE=spawn
CODEX_WEB_CODEX_BIN=codex
CODEX_WEB_APP_SERVER_HOST=127.0.0.1
# CODEX_WEB_APP_SERVER_PORT=31317
# CODEX_WEB_APP_SERVER_STATE_DIR=/tmp/codex-web-app-server
# CODEX_WEB_APP_SERVER_URL=ws://127.0.0.1:31317
