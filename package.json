{
  "name": "codex-web-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx src/server/http.ts",
    "build": "npm run typecheck && node scripts/build-next.mjs && npm run build:server",
    "build:server": "node scripts/build-server.mjs",
    "start": "node scripts/start-production.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "release:pack": "node scripts/pack-release.mjs",
    "release:smoke": "node scripts/smoke-release.mjs",
    "release:verify": "npm run verify && npm run build && npm run release:pack && npm run release:smoke",
    "docker:build": "node scripts/build-docker.mjs",
    "docker:smoke": "node scripts/smoke-docker.mjs",
    "verify": "npm run typecheck && npm run test"
  },
  "dependencies": {
    "@next/env": "^16.2.9",
    "cookie": "^1.0.2",
    "diff": "8.0.2",
    "highlight.js": "11.10.0",
    "mermaid": "11.6.0",
    "nanoid": "^5.1.6",
    "next": "^16.2.9",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-markdown": "9.0.1",
    "rehype-highlight": "7.0.1",
    "remark-gfm": "4.0.0",
    "ws": "^8.18.3",
    "zod": "^4.1.0",
    "zustand": "5.0.2"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.10.0",
    "@types/react": "19.2.17",
    "@types/ws": "^8.5.13",
    "cross-env": "^10.0.0",
    "esbuild": "^0.28.1",
    "happy-dom": "^20.10.6",
    "jsdom": "^29.1.1",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^4.0.0"
  }
}
